	"type": "module",
	"dependencies": {
		"@djibb/client": "*",
		"@djibb/protocol": "*",
		"@tabler/icons-svelte": "^3.34.0",
		"partysocket": "^1.0.1",
		"zod": "^4.0.17"
	}
}
