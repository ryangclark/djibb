# Copy to `.env` for the SvelteKit dev server, then restart it (Vite
# reads .env only at startup). Gitignored — safe for the license key.
#   cp .env.example .env

# Base URL of the Worker/API backend — a DIFFERENT origin from this
# frontend (the cross-origin split is what the Worker's CORS/CSRF + OAuth
# checks rely on; see docs/DEPLOY.md). Local dev: the combo `npm start`
# script (../npmrundev.mjs) runs the Worker on port 8787. In production
# point at the Worker's custom domain (https://api.djibb.com), NOT the
# site's apex (https://djibb.com).
VITE_API_BASE_URL=http://localhost:8787

# Replicache sync endpoint (host:port of the Worker, no scheme). Prod:
# api.djibb.com
VITE_REPLICACHE_BASE_URL=localhost:8787

# (Replicache no longer needs a license key — it went open source, so
# there's no VITE_REPLICACHE_LICENSE_KEY anymore.)
