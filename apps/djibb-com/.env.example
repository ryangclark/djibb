# Copy to `.env` for the SvelteKit dev server, then restart it (Vite
# reads .env only at startup). Gitignored — safe for the license key.
#   cp .env.example .env

# Origin of the Worker/API backend — a DIFFERENT origin from this frontend
# (the cross-origin split is what the Worker's CORS/CSRF + OAuth checks rely
# on; see docs/DEPLOY.md). One origin serves everything: fetch API, the
# Replicache sync endpoint, and the websocket — the ws(s):// and http-vs-https
# choices derive from this URL's own scheme (src/lib/config.js). Local dev:
# the combo `npm start` script (../npmrundev.mjs) runs the Worker on port
# 8787. In production point at the Worker's custom domain
# (https://api.djibb.com), NOT the site's apex (https://djibb.com).
VITE_DJIBB_ORIGIN=http://localhost:8787

# (Replicache no longer needs a license key — it went open source, so
# there's no VITE_REPLICACHE_LICENSE_KEY anymore.)
