# Copy to `.env` for the SvelteKit dev server, then restart it (Vite
# reads .env only at startup). Gitignored — safe for the license key.
#   cp .env.example .env

# Base URL of the Worker/API backend. Local dev: the combo `npm start`
# script (../npmrundev.mjs) runs the Worker on port 8787. Swap to the
# production origin (https://djibb.com/) when pointing at deployed infra.
VITE_API_BASE_URL=http://localhost:8787

# Replicache sync endpoint (host:port of the Worker, no scheme).
VITE_REPLICACHE_BASE_URL=localhost:8787

# Replicache license key (https://replicache.dev — `npx replicache get-license`).
VITE_REPLICACHE_LICENSE_KEY=
