.DS_Store
node_modules
/apps/djibb-com/build
/apps/djibb-com/.svelte-kit
/apps/djibb-com/package
# Path-agnostic so these stay ignored after the ADR-0014 package moves
# (workers → packages/server-cf, pages → apps/djibb-com). Local wrangler
# state and the secret-bearing .dev.vars must never be committed; the
# checked-in .dev.vars.example is a different name and stays tracked.
.wrangler/
.dev.vars
.env
.env.*
!.env.example
# Committed: non-secret prod build-time config (inlined into the public
# client bundle). See apps/djibb-com/.env.production.
!.env.production
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Claude Code project dir: keep local state out, but track shared skills so
# they travel with the repo (the contribute-a-list skill, future skills).
.claude/*
!.claude/skills/

# Contributed lists are a local holding pen, not repo content: proposals
# that `djibb contribute` writes here until a prod "Contributed" List
# houses them (see #9). Untracked so they don't accrete in git history.
seed/contributed/

# Generated TypeScript declaration files under the server-cf src (the
# .ts sources are authoritative; keep the hand-written env.d.ts).
packages/server-cf/src/**/*.d.ts
!packages/server-cf/src/**/env.d.ts
